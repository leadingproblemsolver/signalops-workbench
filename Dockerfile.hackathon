FROM python:3.13-slim

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN python -m pip install --no-cache-dir .

RUN useradd --create-home --uid 10001 signalops
USER signalops
WORKDIR /home/signalops

ENV PORT=8080
ENV SIGNALOPS_DB=/tmp/signalops-hackathon.db

CMD ["sh", "-c", "uvicorn signalops.hackathon:app --host 0.0.0.0 --port ${PORT:-8080}"]
